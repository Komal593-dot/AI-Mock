def vacuum_agent(location, status):
    if status == "Dirty":
        return "Suck"
    elif location == "A":
        return "Move Right"
    else:
        return "Move Left"


# Example environment
location = "A"
status = "Dirty"

action = vacuum_agent(location, status)
print("Location:", location)
print("Status:", status)
print("Action:", action)
