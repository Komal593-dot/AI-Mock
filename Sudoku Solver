def solve(board):
    for r in range(9):
        for c in range(9):

            if board[r][c] == 0:
                for num in range(1, 10):

                    if valid(board, r, c, num):
                        board[r][c] = num

                        if solve(board):
                            return True

                        board[r][c] = 0

                return False

    return True


def valid(board, r, c, num):

    # Row
    if num in board[r]:
        return False

    # Column
    if any(board[i][c] == num for i in range(9)):
        return False

    # 3x3 box
    br = (r // 3) * 3
    bc = (c // 3) * 3

    for i in range(br, br + 3):
        for j in range(bc, bc + 3):
            if board[i][j] == num:
                return False

    return True


