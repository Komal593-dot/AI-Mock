from collections import deque

def hanoi(n):
    start = tuple([tuple(range(n, 0, -1)), (), ()])
    goal = ((), (), tuple(range(n, 0, -1)))

    queue = deque([(start, [])])
    visited = {start}

    while queue:
        state, path = queue.popleft()

        if state == goal:
            return path + [state]

        for i in range(3):
            if not state[i]:
                continue

            for j in range(3):
                if i == j:
                    continue

                if not state[j] or state[i][-1] < state[j][-1]:
                    new_state = [list(x) for x in state]
                    disk = new_state[i].pop()
                    new_state[j].append(disk)

                    new_state = tuple(tuple(x) for x in new_state)

                    if new_state not in visited:
                        visited.add(new_state)
                        queue.append(
                            (new_state, path + [state])
                        )

solution = hanoi(3)

for state in solution:
    print(state)
